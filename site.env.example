# Host-specific paths. Copy to site.env and fill in; config.env sources it.
# Write each as VAR="${VAR:-value}" so a value from the environment wins.
SCR="${SCR:-/path/to/local/nvme/flex_paper}"              # fast local scratch (may be ephemeral)
DUR="${DUR:-/path/to/durable/storage/paper_final}"        # durable copy of every deliverable
DATA_ROOT="${DATA_ROOT:-/path/to/data_root}"             # inputs: fastq/<ds>/, refs/<ds>/, refs/cr_ref/ (README "Input files you provide")
PY="${PY:-/path/to/envs/scbp/bin/python}"                 # python of the scbp env (scanpy; R with SoupX, scDblFinder, scran, scry)
CELLRANGER_BIN="${CELLRANGER_BIN:-/path/to/cellranger-10.1.0/bin/cellranger}"
