# Single source of truth for the alevin-fry Flex paper reproduction. Every step script sources this.
# Change a value here, never inside a step.

# ---------------- paths ----------------
REPRO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"     # this package = the directory of this file (flex-paper/reproduce)
SRC="$REPRO/src"                                   # tool checkouts (step 01)
# Host-specific paths live in site.env (copy site.env.example and fill it in). Every value there may
# also come from the environment, and an environment value wins.
[[ -f "$REPRO/site.env" ]] && source "$REPRO/site.env"
: "${SCR:?SCR unset: set it in $REPRO/site.env (fast local scratch, may be ephemeral)}"
: "${DUR:?DUR unset: set it in $REPRO/site.env (durable copy of every deliverable)}"
: "${DATA_ROOT:?DATA_ROOT unset: set it in $REPRO/site.env (holds fastq/ and refs/)}"
: "${PY:?PY unset: set it in $REPRO/site.env (python of the scbp env: scanpy / R with SoupX, scDblFinder, scran, scry)}"
: "${CELLRANGER_BIN:?CELLRANGER_BIN unset: set it in $REPRO/site.env (pre-installed Cell Ranger 10.1.0)}"
FASTQ_SRC="$DATA_ROOT/fastq"   # downloaded inputs (step 02 stages them to $SCR/fastq)
REFS_SRC="$DATA_ROOT/refs"     # probe sets + barcode lists
# cyto and Cell Ranger matrices of steps 07-13 = step 05b's rep1 (05b is their only producer):
#   $CR_OUT/<ds>/$CR_SUBPATH/<sample>/sample_filtered_feature_bc_matrix.h5 and $CYTO_OUT/<ds>/cyto/counts/<sample>/
CR_OUT="$DUR/05b_timing_cyto_cellranger"; CR_SUBPATH="cellranger/per_sample_outs_rep1"
CYTO_OUT="$DUR/05b_timing_cyto_cellranger"
# per-dataset inputs: data/datasets.tsv holds paths under {DATA_ROOT}; the resolved copy is
# written here when missing or out of date, so every reader (awk in the steps, flexio.py) sees real paths
DATASETS_TEMPLATE="$REPRO/data/datasets.tsv"
DATASETS_TSV="$REPRO/data/datasets_resolved.tsv"
if ! cmp -s <(sed "s|{DATA_ROOT}|$DATA_ROOT|g" "$DATASETS_TEMPLATE") "$DATASETS_TSV" 2>/dev/null; then
  sed "s|{DATA_ROOT}|$DATA_ROOT|g" "$DATASETS_TEMPLATE" > "$DATASETS_TSV.$$" && mv -f "$DATASETS_TSV.$$" "$DATASETS_TSV"
fi

DATASETS="40k_DTC 16plex_human 320k_GEMX Flexv2_16k_Human 16k_mouse_Spleno"   # v1 first: no anchor, unaffected by GEOM_V2

# ---------------- pinned toolchain ----------------
SIMPLEAF_REPO="https://github.com/COMBINE-lab/simpleaf.git";   SIMPLEAF_COMMIT="645841e"   # simpleaf dev: 0.31.0 + PR #224 (multiplex-quant --umi-edit-dist); --version still 0.31.0
ALEVINFRY_REPO="https://github.com/COMBINE-lab/alevin-fry.git"; ALEVINFRY_COMMIT="1117219" # alevin-fry 0.19.0 (tag v0.19.0, libradicl 0.21)
PISCEM_REPO="https://github.com/COMBINE-lab/piscem.git";       PISCEM_COMMIT="b19ee69"    # piscem 0.24.0 (tag v0.24.0), piscem-rs 0.11.1
PISCEM_RS_VERSION="0.11.1"
RUSTFLAGS_BUILD="-C target-cpu=native"
CYTO_VERSION="0.4.6"; CELLRANGER_VERSION="10.1.0"

# ---------------- final simpleaf configuration ----------------
KMER=19; MINIMIZER=15
EXCLUDED_PROBES="decoy"                 # included=FALSE probes indexed as poison decoys
GEOM_V2='1{b[16]u[12]x[0-4]hamming(f[TTGCTAGGACCG],1)s[10]x:}2{r:}'   # Flex v2: 12-nt anchor with one mismatch, spacers 0-4
GEOM_V1='1{b[16]u[12]x:}2{r[50]x[18]s[8]x:}'
CELL_BC_CORRECTION="frequency"; SAMPLE_BC_CORRECTION="frequency"
UMI_EDIT_DIST=1                          # one-mismatch UMI collapse (Figure 1 caption)
RESOLUTION="cr-like"; DECODER="auto"; COMPRESS="lz4"   # lz4 = simpleaf default collate codec

# ---------------- benchmark protocol ----------------
THREADS=32; CPUSET="0-31"; MEM_LIMIT="300g"; WARMUP=1; REPS=3   # TIMING ONLY (step 05/05b), every tool: docker container, idle host
CR_LOCALMEM="${MEM_LIMIT%g}"; CR_REPS=1   # Cell Ranger: multi --localcores $THREADS --localmem 300 (= the container cap); 1 rep, no warmup (~7.6 h for 320k)
# step 05b dataset order: smallest GEX FASTQ first (57 / 77 / 249 / 341 / 709 GB); must be a permutation of $DATASETS
TIMING_ORDER="Flexv2_16k_Human 16k_mouse_Spleno 40k_DTC 16plex_human 320k_GEMX"
# Everything that is not timed uses the whole host (64 vCPU, 495 GiB). Matrix digests are thread-invariant.
ANALYSIS_THREADS=64        # per job for non-timed tools (multiplex-quant --untimed, af quant, piscem)
# report MIN wall and MAX peak VmHWM over the timed reps; all byte sizes are GiB (2^30)

# ---------------- toolchain self-verify expectations (steps 01/04) ----------------
SIMPLEAF_VERSION="0.31.0"; ALEVINFRY_VERSION="0.19.0"; PISCEM_VERSION="0.24.0"
LIBRADICL_MINOR="0.21"                   # alevin-fry Cargo.lock must pin libradicl 0.21.x
AF_PR196_ANCESTOR="a0bc3c8"              # alevin-fry PR #196 (umi-edit-dist) must be an ancestor
CYTO_REPO="https://github.com/arcinstitute/cyto"; CYTO_TAG="cyto-0.4.6"; CYTO_COMMIT="25148bada8d28c8e157c67f3264ebe7b53054926"
CYTO_LOCK="$REPRO/data/cyto/Cargo.lock"  # cyto does not commit a Cargo.lock; step 01 builds --locked with this one
CYTO_BIN="$SRC/cyto/target/release/cyto" # built by step 01 (cargo build --release --locked -p cyto)
# CELLRANGER_BIN (site.env): pre-installed 10x download (README); step 01 records version + sha256
AF_HOME="$SCR/af_home"                   # ALEVIN_FRY_HOME written by step 01 set-paths
AF_BIN="$SRC/alevin-fry/target/release/alevin-fry"   # = steps/01_toolchain.sh $AF; registered by set-paths

# ---------------- inputs (step 02) ----------------
NONGEX_RE='(_ab_|/ab/|_ab/|_crispr|_cmo_|/vdj|_vdj|antibody|protein)'   # non-GEX library names, excluded from staging and timing

# ---------------- index (step 03) ----------------
INDEX_THREADS=32                         # = build_idx19.log (simpleaf passes --seed 1 --dict auto --ram-limit-gib 8 by default)
PANELS="human_v1.1.0 human_v2.0.0 mouse_v2.0.0"

# ---------------- toolchain gate (step 04) ----------------
GATE_DATASET="Flexv2_16k_Human"
GATE_GEOM='1{b[16]u[12]x[0-4]hamming(f[TTGCTAGGACCG],1)s[10]x:}2{r:}'   # the gate geometry, held separate from GEOM_V2
GATE_DIGEST_REF="$REPRO/data/perprobe_digest_ref.tsv"   # per-probe (quant-probe) matrices; Flexv2 = 4d581c19dd1ea067 (provenance: lib/make_perprobe_ref.sh)
GATE_NUM_MAPPED=782543700; GATE_NUM_POISONED=98776     # expected mapped and poisoned read counts of the gate run
GATE_NNZ=49109599; GATE_TOTAL=138856634                # per-probe reference run (lib/make_perprobe_ref.sh, 645841e), digest 4d581c19dd1ea067

# ---------------- step 12 probe biology / step 14 figures ----------------
PROBE_ENV="$REPRO/envs/probe"              # venv over scbp + pydeseq2 0.5.4 / celltypist (scbp lacks pydeseq2); step 00 builds it from envs/probe/freeze.txt
PY_PROBE="$PROBE_ENV/bin/python"; PYDESEQ2_VERSION="0.5.4"
GENOME_HUMAN="${GENOME_HUMAN:-$REFS_SRC/cr_ref/refdata-gex-GRCh38-2024-A}"   # fasta/genome.fa + genes/genes.gtf* (probe relocation)
GENOME_MOUSE="${GENOME_MOUSE:-$REFS_SRC/cr_ref/refdata-gex-GRCm39-2024-A}"
PROBE_BIO_DATASETS="320k_GEMX 16plex_human 16k_mouse_Spleno"  # libraries the probe-level analyses run on
PREMRNA_TABLE_DS="16plex_human"          # library whose junction/within-exon table is written; both 16plex and 320k are produced
PREMRNA_FIG_HUMAN_DS="320k_GEMX"         # human library of the junction/within-exon panels
P12_REMOVE_DOUBLETS="${P12_REMOVE_DOUBLETS:-1}"   # step 12: drop scDblFinder doublets from every pseudobulk / cell-level analysis
# Figure 2 panel a + Figure 2 panel a: one example per story, each "DATASET|CELL TYPE|GENE" (the two may
# come from different libraries and cell types; the dataset must be one of PROBE_BIO_DATASETS)
FIG2_PANEL_A_DILUTED="${FIG2_PANEL_A_DILUTED:-320k_GEMX|Naive B cells|ZBTB16}"        # probes move, the largest stays flat
FIG2_PANEL_A_CANCELLING="${FIG2_PANEL_A_CANCELLING:-320k_GEMX|Memory B cells|FOSB}"  # probes move in opposite directions
# step 12 runs on PROBE_BIO_DATASETS plus the libraries of the two panel-a examples (derived)
P12_DATASETS_ALL="$PROBE_BIO_DATASETS"
for _d in "${FIG2_PANEL_A_DILUTED%%|*}" "${FIG2_PANEL_A_CANCELLING%%|*}"; do
  [[ " $P12_DATASETS_ALL " == *" $_d "* ]] || P12_DATASETS_ALL+=" $_d"; done; unset _d
FIG2_SEARCH_DATASETS="${FIG2_SEARCH_DATASETS:-$DATASETS}"   # step 12 s: candidate search for panel a (every library; --full only)

FIG2_SEARCH_MAX_RANK=500                 # step 12 s: CellTypist marker rank cut of the candidate table
STORY_DS="320k_GEMX"; STORY_LABEL="Naive B cells"; STORY_GENES="PHACTR1"           # Figure 2 panel b (PHACTR1)
MIN_PROBE_UMI_FLOOR=10                   # per-probe DE: >= this many UMI summed over target AND over rest columns
DE_MIN_CELLS=100; DE_MIN_SAMPLES=3       # a cluster is analysed when in >= 3 samples with >= 100 cells
UMAP_K_POOL=100; UMAP_N_NEIGHBORS=15; UMAP_SEED=0
RATIO_DS="16k_mouse_Spleno"              # Figure 2 panel c (10x region column)

# ---------------- steps 05-07 (simpleaf timing, gene matrices, probe matrices) ----------------
INDEX_ROOT="$SCR/index"                  # step 03 output on NVMe (durable copy $DUR/03_index/<panel>): <panel>/index/{piscem_idx.*,t2g_2col.tsv}
TIMING_IMAGE="ubuntu:24.04"              # docker image of every timed run (lib/run_in_container.sh)
EVICT_MAX_RESIDENT_PCT=1.0               # FASTQ page-cache residency after posix_fadvise eviction must be below this (mincore)
IDLE_CONTAINER_RE='^(repro_|cr_|afrt_|cytort_|conc_|sa_|rt_)'   # docker names that mean "box busy" (repro_ = steps 05/05b)
IDLE_PROC_RE="(piscem map-sc|alevin-fry (generate-permit-list|collate|quant)|simpleaf multiplex-quant|cellranger|cyto workflow|A30_concordance_k19\.sh|(cp|rsync) .*$SCR)"
IDLE_LOAD_MAX=6                          # 1-min load must be below this before a dataset's warmup (not between its reps)
IDLE_POLL_S=30; IDLE_LOG_EVERY_S=600
PROBE_THREADS="$ANALYSIS_THREADS"        # untimed probe re-quant
PROBE_LOSS_MAX=0.005; PROBE_LOGCORR_MIN=0.999   # structural probe->gene gate
PROBE_ANNOT_DIR="$REPRO/data/probe_annot"     # <probe-set basename>.tsv per panel (probe_matrix.py export .var)
PROBE_EXPORT_DATASETS="$DATASETS"        # step 07 export: every library (step 12 s searches all five for panel a)
DIGEST_REF_TSV="$GATE_DIGEST_REF"         # steps 05/06: every matrix of every dataset must equal its per-probe reference digest here (untimed 64-thread run, lib/make_perprobe_ref.sh)
PRIOR_INDEX_ROOT="$REFS_SRC/index_k19"   # k19/m15 decoy indices to compare the t2g against

# ---------------- steps 08-11 (concordance, clustering, pooled UMAP, cell types) ----------------
# simpleaf arm = step 06: $SA_QUANT_ROOT/<ds>/$SA_QUANT_SUBDIR (+ $SA_QUANT_ROOT/<ds>/.done). Tests override both.
SA_QUANT_ROOT="$DUR/06_gene_matrices"; SA_QUANT_SUBDIR="af_quant"
CONC_JOBS=32                              # parallel per-sample python jobs (counts, clustering, kmatch, deg); untimed: they are I/O-bound on network storage (~20% CPU each), so 32 at once
CLUST_THREADS=8                           # BLAS/R threads per job (CONC_JOBS x CLUST_THREADS ~ 64-96 on the i4i)
# lib/scbp_pipeline.py hard-codes the book's parameters, which are the paper's
# Methods: MAD 5 (counts, genes, top-20 pct) / 3 (mito) + mito > 8% dropped, SoupX, filter_genes min_cells 20,
# scDblFinder (doublets marked, kept: CLUST_REMOVE_DOUBLETS=0), scran pooling (min.mean 0.1), scry deviance top 4000, PCA arpack, 30 PCs, Leiden
# igraph n_iterations 2 at res 0.25/0.5/1.0, seed 0. They are NOT re-declared here (the code is the record).
CLUST_REMOVE_DOUBLETS="${CLUST_REMOVE_DOUBLETS:-0}"                   # 1 = drop scDblFinder doublets before normalization
CLUST_N_DEVIANT="${CLUST_N_DEVIANT:-4000}"                      # deviance-selected genes for PCA (paper: 4000)
KMATCH_LO=0.02; KMATCH_HI=6.0; KMATCH_BISECT_STEPS=18      # = benchmark kmatch_clustering.py bisection
KMATCH_SCAN_STEP=0.005; KMATCH_SCAN_MIN=0.0001; KMATCH_FINE_STEP=0.0001   # dense-scan fallback when bisection misses the target k
SWEEP_K="$SWEEP_K_FULL"
SEEDCTL_SEED=1; SEEDCTL_MAX_SAMPLES=4; SEEDCTL_DATASETS="16plex_human 320k_GEMX 40k_DTC"   # Methods: "12 of 44 samples"
MARKER_TOP=50                             # top-N Wilcoxon markers per matched cluster
UMAP_DATASET="16plex_human"               # step 10 pooled UMAP library
# step 10, what the paper uses (Supp. Figure 1): Cell Ranger's embedding of the book variant only. Optional, not in the
# paper: UMAP_TOOLS="cellranger simpleaf cyto" (per-tool pooled embeddings, equal-k matching, pooled ARIs) and
# P10_VARIANTS="basic book" (the plain scanpy variant); the 1 x 3 plot needs all three tools.

UMAP_MIX_K=30                             # kNN (PCA space) for the sample-mixing entropy
UMAP_MIX_MIN=0.90                         # kNN sample entropy / within-cluster-permuted null >= this -> no batch correction
CELLTYPIST_VERSION="1.7.1"; CELLTYPIST_MODEL="Immune_All_Low.pkl"
CELLTYPIST_MODEL_SHA256="290874d35dac039d4c9218c343fde4aac1077709b72a331ce7266f6828c36502"   # the model file the labels were made with; step 11 fails on any other
HARMONYPY_VERSION="0.0.10"                # installed with CellTypist; step 10b uses it only if mixing fails
EXT_ENV="$REPRO/envs/scbp_ext"            # venv over the scbp env (--system-site-packages) + celltypist/harmonypy
EXT_PY="$EXT_ENV/bin/python"
MGI_HOMOLOGY="$REPRO/data/HOM_MouseHumanSequence.rpt"   # MGI mouse-human homology report (1:1 classes); lib/celltype_annotate.py reads the same file
STORY_TX="ENST00000379329 ENST00000379335"   # PHACTR1-202, PHACTR1-203 (Figure 2 panel b probe selection)
STORY_PANEL_A="$FIG2_PANEL_A_GENES"; STORY_PANEL_B="PHACTR1"
RATIO_ORDER="Naive B cells|germinal_centre_B+proliferating|proliferating"   # Figure 2 panel c: order checked per sample

# ---------------- step 13 (read-level discordance accounting, Supplement "Sources of residual discordance") ----------------
READLEVEL_DS="16k_mouse_Spleno"          # the supplement's diagnostic library (Flex v2, samples E01-H01)
CR_BAM_OUT="$DUR/13_readlevel/cr_mouse_bam/outs"   # step 13 bam: Cell Ranger 10.1.0 on $READLEVEL_DS WITH BAMs (untimed); step 13 f checks it equals $CR_OUT's run
CR_BAM_THREADS=16; CR_BAM_LOCALMEM=120   # step 13 bam is untimed but runs beside 07/08/09: a quarter of the host, so clustering and the probe quants are not starved
READLEVEL_CHUNKS=16                       # coordinate chunks per CR BAM (one BAM-pass worker each)
READLEVEL_JOBS=64                         # concurrent BAM-pass workers (4 BAMs x 16 chunks); step 13 is untimed: whole host
READLEVEL_THREADS=64; READLEVEL_CPUSET="0-63"   # piscem / multiplex-quant threads in step 13 a and c
INDEX_MAGICS="piscem_idx.poison=PPOIS02 piscem_idx.ectab=PECTB04"   # piscem-rs 0.11 on-disk formats (0.10 wrote PPOIS01 / PECTB03)
P12_JOBS=16; P12_THREADS=4               # step 12 (untimed): concurrent jobs x threads per job = 64 vCPU
P12_EMBED_THREADS=64                     # the single pooled-embedding process

# ---------------- whole-host settings for untimed work ----------------
CARGO_JOBS=64                            # step 01 cargo build -j
STAGE_STREAMS=8                          # step 02 parallel cp streams PER dataset (datasets may also run concurrently)
GATE_THREADS=64; GATE_CPUSET="0-63"      # step 04 gate is untimed and the digest is thread-invariant

# ---------------- steps/run_all.sh (end-to-end driver) ----------------
RUNALL_IO_JOBS=5          # concurrent step-02 dataset stagings ($STAGE_STREAMS cp streams each)
RUNALL_GENE_JOBS=3        # concurrent step-06 gene multiplex-quant nodes (own cap: a long 06 never waits behind 07s)
RUNALL_QUANT_JOBS=2       # concurrent 04 / 07 / 07ed0 / 07ed1 quant nodes (each uses $ANALYSIS_THREADS)
# RUNALL_*_JOBS are re-read by run_all.sh on every scheduling loop
RUNALL_ANALYSIS_JOBS=4    # concurrent 08-13 nodes (each manages its own internal job count)
FIG_UMAP_DONORS="${FIG_UMAP_DONORS:-all}"   # Figure 2 panels a AND b: all donors of $STORY_DS, or a comma list

# ---------------- what is produced: the paper (default) or everything (run_all.sh --full -> FULL=1) ----------------
# Default: only what the manuscript shows. --full adds every exploratory / supporting analysis:
#   09  seed control (SEEDCTL_*) and the k sweep (SWEEP_K)            10  simpleaf + cyto pooled embeddings, equal-k
#   matching, pooled ARIs, the basic variant and the 1 x 3 plot       11  cell types of every library (default: the
#   story and pooled libraries)        12  every PROBE_BIO_DATASETS library, the 10x-region ratio (d), the
#   junction/within-exon panels (f) and the panel-a candidate search (s) (default: the story library)
FULL="${FULL:-0}"
if (( FULL )); then
  UMAP_TOOLS="cellranger simpleaf cyto"; P10_VARIANTS="basic book"
  CELLTYPE_DATASETS="$DATASETS"
  P12_OPTIONAL="d f_extra s"
else
  SWEEP_K=""; SEEDCTL_DATASETS=""
  UMAP_TOOLS="cellranger"; P10_VARIANTS="book"
  CELLTYPE_DATASETS="$STORY_DS"; [[ " $CELLTYPE_DATASETS " == *" $UMAP_DATASET "* ]] || CELLTYPE_DATASETS+=" $UMAP_DATASET"
  P12_DATASETS_ALL="$STORY_DS"
  P12_OPTIONAL=""
fi
